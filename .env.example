# required: OpenRouter key (free models only, no credits needed)
OPENROUTER_API_KEY=
# required for the "zai:" and "claude:" council members and the screenshot describer.
# "zai:" calls z.ai's general API, where the flash models are free (any z.ai key works);
# "claude:" models run through the local Claude Code CLI with this key injected as its
# Anthropic login, so a GLM Coding Plan covers them too
ZAI_API_KEY=
ZAI_REQUESTS_PER_MINUTE=20
CLAUDE_BASE_URL=https://api.z.ai/api/anthropic
# only needed when ZAI_API_KEY points somewhere else (for example a mock in tests)
CLAUDE_API_KEY=
CLAUDE_REQUESTS_PER_MINUTE=20
# recommended: a GitHub token with public read access, raises the API limit from 60 to 5000 requests an hour
GITHUB_TOKEN=
# required to hide reviews: POST /api/admin/reviews/<id>/hide with "Authorization: Bearer <token>"
ADMIN_TOKEN=
# optional
IP_SALT=
DAILY_LIMIT=50
REQUESTS_PER_MINUTE=15
SUBMISSIONS_PER_HOUR=3
PORT=3000
DATA_DIR=/data
TRUST_PROXY=1
