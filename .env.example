# required: OpenRouter key (free models only, no credits needed)
OPENROUTER_API_KEY=
# required for the "zai:" council member and the screenshot describer: a z.ai general API key
# (not a GLM Coding Plan key; that plan only covers z.ai's list of coding tools). the flash models are free
ZAI_API_KEY=
ZAI_REQUESTS_PER_MINUTE=20
# recommended: a GitHub token with public read access, raises the API limit from 60 to 5000 requests an hour
GITHUB_TOKEN=
# required to hide reviews: POST /api/admin/reviews/<id>/hide with "Authorization: Bearer <token>"
ADMIN_TOKEN=
# optional
IP_SALT=
DAILY_LIMIT=50
REQUESTS_PER_MINUTE=15
SUBMISSIONS_PER_HOUR=3
PORT=3000
DATA_DIR=/data
TRUST_PROXY=1
MEMBER_MAX_TRIES=6
