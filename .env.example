# required: OpenRouter key for the free members (50 requests a day, 1000 once the account has credits)
OPENROUTER_API_KEY=
# required for the "claude:" and "zai:" council members and the screenshot describer.
# "claude:" runs the Claude Code CLI on the GLM Coding Plan; "zai:" calls z.ai's general API
# (free flash models)
ZAI_API_KEY=
ZAI_REQUESTS_PER_MINUTE=20
CLAUDE_BASE_URL=https://api.z.ai/api/anthropic
# only needed when ZAI_API_KEY points somewhere else (for example a mock in tests)
CLAUDE_API_KEY=
CLAUDE_REQUESTS_PER_MINUTE=20
# recommended: a GitHub token with public read access, raises the API limit from 60 to 5000 requests an hour
GITHUB_TOKEN=
# required to hide reviews: POST /api/admin/reviews/<id>/hide with "Authorization: Bearer <token>"
ADMIN_TOKEN=
# optional
IP_SALT=
DAILY_LIMIT=1000
REQUESTS_PER_MINUTE=15
SUBMISSIONS_PER_HOUR=3
PORT=3000
DATA_DIR=/data
TRUST_PROXY=1
